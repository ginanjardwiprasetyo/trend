# Matikan MultiViews dan Indexes untuk menghindari konflik dan menyembunyikan struktur folder
Options -MultiViews -Indexes

# Konfigurasi Error secara dinamis (XAMPP vs Render)
<If "%{REQUEST_URI} =~ m#^/project01/#">
    ErrorDocument 404 /project01/error.html
    ErrorDocument 403 /project01/error.html?error=forbidden
</If>
<Else>
    ErrorDocument 404 /error.html
    ErrorDocument 403 /error.html?error=forbidden
</Else>

RewriteEngine On

# 1. Hapus Trailing Slash (biar /data/ jadi /data)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)/$ $1 [L,R=301]

# 2. Tangani file .php (prioritas)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^([^.]+)$ $1.php [NC,L]

# 3. Tangani file .html (fallback)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^([^.]+)$ $1.html [NC,L]

